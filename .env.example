# Copy this file to a new file named .env and put your real key there.
# .env is ignored by Git, so your key never gets uploaded.
# (`vercel dev` reads .env when running the app on your computer.)
#
# Get a free key at https://developer.ticketmaster.com (use the "Consumer Key").
# On Vercel, add the same name under Project -> Settings -> Environment Variables.
#
# Important: the name must NOT start with VITE_, or Vite would put it in the
# browser code where anyone could see it.
TICKETMASTER_API_KEY=paste-your-key-here
